# Default: normalize all text files to LF
* text=auto eol=lf

# Keep Windows scripts using CRLF
*.bat eol=crlf
*.cmd eol=crlf

# Shell scripts should always be LF
*.sh eol=lf

# Prevent Git from touching binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary